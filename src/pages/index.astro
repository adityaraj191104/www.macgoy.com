---
import "@/styles/main.scss";
import {
  ArrowRight,
  BadgeIndianRupee,
  CheckCircle2,
  CircleHelp,
  CirclePlay,
  LayoutGrid,
  Rocket,
  ShieldCheck,
  Sparkles,
  Users,
} from "lucide-react";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BizNeev — The Zero-Rupee Startup Blueprint</title>
    <meta
      name="description"
      content="BizNeev is a practical digital blueprint with 50 actionable business playbooks you can start this weekend with near-zero investment."
    />
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute left-1/2 top-[-180px] h-[460px] w-[460px] -translate-x-1/2 rounded-full bg-emerald-500/20 blur-3xl"></div>
      <div class="absolute bottom-[-180px] right-[-120px] h-[360px] w-[360px] rounded-full bg-indigo-500/20 blur-3xl"></div>
    </div>

    <header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-xl">
      <nav class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href="#" class="group inline-flex items-center gap-2">
          <span class="text-2xl font-bold tracking-tight text-white">BizNeev</span>
          <span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-300 transition group-hover:border-emerald-300/50 group-hover:bg-emerald-300/15">50 Playbooks Inside</span>
        </a>

        <ul class="hidden items-center gap-7 text-sm font-medium text-slate-300 md:flex">
          <li><a href="#why" class="transition hover:text-white">Why This Blueprint</a></li>
          <li><a href="#inside" class="transition hover:text-white">What's Inside</a></li>
          <li><a href="#faqs" class="transition hover:text-white">FAQs</a></li>
        </ul>

        <a href="#checkout" class="inline-flex items-center gap-2 rounded-full bg-emerald-400 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:scale-[1.02] hover:bg-emerald-300">
          Get Blueprint (₹99)
          <ArrowRight className="h-4 w-4" />
        </a>
      </nav>
    </header>

    <main>
      <section class="mx-auto grid w-full max-w-7xl gap-10 px-4 pb-20 pt-14 sm:px-6 lg:grid-cols-2 lg:gap-14 lg:px-8 lg:pt-20">
        <div class="space-y-7">
          <span class="inline-flex items-center rounded-full border border-indigo-400/40 bg-indigo-400/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-indigo-200">⚡ Zero Theory • 100% Execution</span>

          <h1 class="text-balance text-4xl font-black leading-tight text-white sm:text-5xl lg:text-6xl">
            Build a Real Business This Weekend — Without Spending a Single Rupee.
          </h1>

          <p class="max-w-2xl text-lg leading-relaxed text-slate-300">
            50 curated, battle-tested modern blueprints designed for students, freelancers, and ambitious starters. Skip the heavy funding and launch lean.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a id="checkout" href="#" class="inline-flex items-center gap-2 rounded-xl bg-emerald-400 px-6 py-3.5 text-base font-bold text-slate-950 shadow-lg shadow-emerald-500/25 transition hover:-translate-y-0.5 hover:bg-emerald-300">
              Download Blueprint Now — Only ₹99
              <ArrowRight className="h-5 w-5" />
            </a>
            <span class="text-sm font-semibold text-slate-400">MRP <span class="line-through">₹499</span></span>
          </div>

          <div class="flex flex-wrap gap-3 text-xs font-semibold text-slate-300">
            <span class="inline-flex items-center gap-1 rounded-full border border-white/15 bg-white/5 px-3 py-1.5"><CheckCircle2 className="h-3.5 w-3.5 text-emerald-300" />Instant PDF Delivery</span>
            <span class="inline-flex items-center gap-1 rounded-full border border-white/15 bg-white/5 px-3 py-1.5"><BadgeIndianRupee className="h-3.5 w-3.5 text-emerald-300" />UPI Supported</span>
            <span class="inline-flex items-center gap-1 rounded-full border border-white/15 bg-white/5 px-3 py-1.5"><ShieldCheck className="h-3.5 w-3.5 text-emerald-300" />100% Legal &amp; Actionable</span>
          </div>
        </div>

        <div class="relative flex items-center justify-center">
          <div class="relative w-full max-w-md rounded-3xl border border-white/20 bg-white/5 p-6 shadow-2xl shadow-slate-950/70 backdrop-blur-2xl">
            <span class="absolute -left-4 top-8 rounded-full border border-emerald-300/40 bg-emerald-400/15 px-3 py-1 text-xs font-semibold text-emerald-200">50 Action Steps</span>
            <span class="absolute -right-4 bottom-12 rounded-full border border-indigo-300/40 bg-indigo-400/15 px-3 py-1 text-xs font-semibold text-indigo-200">0 Investment Needed</span>
            <div class="rounded-2xl border border-white/15 bg-gradient-to-b from-slate-800 to-slate-900 p-8 text-center">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-emerald-400/20">
                <Rocket className="h-7 w-7 text-emerald-300" />
              </div>
              <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Digital Bundle</p>
              <h2 class="mt-2 text-2xl font-bold text-white">BizNeev Blueprint</h2>
              <p class="mt-3 text-sm text-slate-300">50 practical micro-business launch paths with ready execution checkpoints.</p>
              <div class="mt-6 grid gap-2 text-left text-sm text-slate-200">
                <p class="inline-flex items-center gap-2"><CirclePlay className="h-4 w-4 text-emerald-300" /> Weekend-friendly action roadmap</p>
                <p class="inline-flex items-center gap-2"><LayoutGrid className="h-4 w-4 text-emerald-300" /> Swipeable framework style format</p>
                <p class="inline-flex items-center gap-2"><Users className="h-4 w-4 text-emerald-300" /> Built for beginners and side-hustlers</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="why" class="mx-auto w-full max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
        <div class="mb-8 max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-300">The Friction</p>
          <h3 class="mt-2 text-3xl font-bold text-white">The problems that stop most people from starting.</h3>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {[
            "Tired of useless 100-page theoretical PDFs?",
            "Don't know where to get your first paying customer?",
            "Zero budget for expensive tools or office setup?",
          ].map((item) => (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:border-emerald-300/50 hover:bg-white/10">
              <p class="text-lg font-semibold leading-snug text-white">{item}</p>
              <p class="mt-3 text-sm text-slate-300">BizNeev gives direct execution steps so you can move from confusion to action fast.</p>
            </article>
          ))}
        </div>
      </section>

      <section id="inside" class="mx-auto w-full max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
        <div class="mb-8 max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-300">Inside the Blueprint</p>
          <h3 class="mt-2 text-3xl font-bold text-white">Everything needed to launch fast and lean.</h3>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            {
              icon: Sparkles,
              title: "Modern Curated Ideas",
              text: "Hand-selected for the Indian internet and mobile-first ecosystem.",
            },
            {
              icon: Users,
              title: "Customer Acquisition Plan",
              text: "Concrete tactics to land customer #1 via WhatsApp, Reels, and outreach.",
            },
            {
              icon: LayoutGrid,
              title: "Free Tech Stack List",
              text: "Zero-cost AI, Canva, and open-source stack to run operations without bills.",
            },
            {
              icon: CirclePlay,
              title: "Ready-to-Use Templates",
              text: "Plug-and-play scripts, outreach templates, and pricing calculators.",
            },
          ].map(({ icon: Icon, title, text }) => (
            <article class="group rounded-2xl border border-white/10 bg-slate-900/70 p-6 transition hover:border-indigo-300/45 hover:bg-slate-900">
              <div class="mb-4 inline-flex rounded-xl border border-white/15 bg-white/5 p-3 text-indigo-300 transition group-hover:border-indigo-300/50">
                <Icon className="h-5 w-5" />
              </div>
              <h4 class="text-lg font-bold text-white">{title}</h4>
              <p class="mt-2 text-sm text-slate-300">{text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="mx-auto w-full max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-white/10 bg-gradient-to-r from-slate-900 via-slate-900 to-indigo-900/30 p-7 sm:p-9">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-300">Who This Is Built For</p>
          <div class="mt-5 flex flex-wrap gap-3">
            {[
              "College Students",
              "Freelancers",
              "Network Marketers",
              "First-Time Founders",
            ].map((item) => (
              <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white">{item}</span>
            ))}
          </div>
        </div>
      </section>

      <section id="faqs" class="mx-auto w-full max-w-7xl px-4 pb-24 sm:px-6 lg:px-8">
        <div class="mb-8 max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-300">FAQs</p>
          <h3 class="mt-2 text-3xl font-bold text-white">Answers before you checkout.</h3>
        </div>

        <div class="space-y-3">
          {[
            {
              q: "Is this a physical book or a digital download?",
              a: "This is a digital blueprint delivered instantly as a downloadable PDF right after purchase.",
            },
            {
              q: "Can I read this on my mobile phone?",
              a: "Yes. The PDF is optimized for mobile and works across phones, tablets, and laptops.",
            },
            {
              q: "What payment methods are supported?",
              a: "UPI, Cards, and NetBanking are supported via instant checkout.",
            },
            {
              q: "Do I need coding or prior business experience to use this?",
              a: "No prior coding or business background is required. The blueprint is written for beginners and action-first learners.",
            },
          ].map(({ q, a }) => (
            <details class="group rounded-xl border border-white/10 bg-white/5 px-5 py-4 open:border-emerald-300/50 open:bg-white/[0.08]">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-semibold text-white">
                {q}
                <CircleHelp className="h-5 w-5 shrink-0 text-emerald-300 transition group-open:rotate-12" />
              </summary>
              <p class="pt-3 text-sm leading-relaxed text-slate-300">{a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="border-y border-white/10 bg-slate-900/70">
        <div class="mx-auto flex w-full max-w-7xl flex-col items-start justify-between gap-5 px-4 py-10 sm:px-6 lg:flex-row lg:items-center lg:px-8">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-300">Final Call</p>
            <h4 class="mt-2 text-2xl font-bold text-white">Launch your first profitable micro-business this weekend with BizNeev.</h4>
          </div>
          <a href="#" class="inline-flex items-center gap-2 rounded-xl bg-emerald-400 px-6 py-3 text-base font-bold text-slate-950 transition hover:bg-emerald-300">
            Get Instant Access — ₹99
            <ArrowRight className="h-5 w-5" />
          </a>
        </div>
      </section>
    </main>

    <footer class="mx-auto w-full max-w-7xl px-4 py-8 text-sm text-slate-400 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-3 border-t border-white/10 pt-6 md:flex-row md:items-center">
        <p>© {new Date().getFullYear()} BizNeev. All rights reserved.</p>
        <div class="flex flex-wrap gap-4">
          <a href="#" class="transition hover:text-white">Terms</a>
          <a href="#" class="transition hover:text-white">Privacy Policy</a>
          <a href="mailto:support@bizneev.in" class="transition hover:text-white">support@bizneev.in</a>
        </div>
      </div>
    </footer>

    <div class="fixed inset-x-3 bottom-3 z-50 rounded-xl border border-emerald-300/30 bg-slate-900/90 p-3 backdrop-blur md:hidden">
      <a href="#checkout" class="flex items-center justify-between rounded-lg bg-emerald-400 px-4 py-2.5 text-sm font-bold text-slate-950">
        <span>Download Blueprint — ₹99</span>
        <ArrowRight className="h-4 w-4" />
      </a>
    </div>
  </body>
</html>
